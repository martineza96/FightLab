# .gitignore — files git should never track. One pattern per line; a trailing "/" means a folder.

# --- Environments, installs and build output (huge, and rebuilt from requirements) ---
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

